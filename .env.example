# Master on/off switch for self-healing. Unset or anything other than false/0 leaves it on.
HEALER_ENABLED=true

# Which provider backs self-healing:
#   ollama | ollama-local | openai | anthropic | gemini | claude-subscription | copilot-subscription | tamash
# Unset, unknown, or an API-key provider whose key/model below is missing disables self-healing —
# a failed action just fails normally. `tamash` is rule-based: no key, no network, no tokens.
HEALER_PROVIDER=ollama

# --- Ollama Cloud (https://ollama.com) ---
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com

# --- Ollama, self-hosted/internal server (a separate provider from Ollama Cloud above) ---
# For your own `ollama serve` instance, or an internal deployment your company hosts. A bare
# `ollama serve` has no auth at all — leave OLLAMA_LOCAL_API_KEY unset. If your deployment sits
# behind a reverse proxy or API gateway that requires a bearer token, set it and it's sent as
# `Authorization: Bearer <token>`; no other auth scheme is currently supported.
# HEALER_PROVIDER=ollama-local
# OLLAMA_LOCAL_MODEL=gpt-oss:120b
# OLLAMA_LOCAL_BASE_URL=http://localhost:11434
# OLLAMA_LOCAL_API_KEY=

# --- OpenAI ---
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- Google Gemini ---
# GEMINI_MODEL=gemini-3.6-flash  # check https://ai.google.dev/gemini-api/docs/models for the current model id
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Claude subscription (no API key) ---
# Uses a Claude Code OAuth token instead of a pay-per-token API key. Get one with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_SUBSCRIPTION_MODEL=claude-haiku-4-5

# --- GitHub Copilot subscription (no API key) ---
# Needs `com.github:copilot-sdk-java` added to your pom.xml (optional dep) AND the `copilot` CLI
# installed & signed in (or an ambient GITHUB_TOKEN).
# COPILOT_SUBSCRIPTION_MODEL=       # leave unset for the SDK/CLI default

# --- tamash (rule-based, no AI) ---
# HEALER_PROVIDER=tamash            # nothing else to configure

# Opt-in: after a locator is healed but the action still fails for a non-selector reason
# (covered / needs scrolling / mid-animation), let the AI pick a retry tactic. Off by default.
# HEALER_ACTION_RECOVERY_ENABLED=true

# How to treat a broken locator resolved inside an assertion:
#   heal   (default) — heal it; a locator is test plumbing, the assertion is the intent
#   warn            — heal it, but flag the test and print a summary of affected tests at the end
#   strict          — do NOT heal inside an assertion; let it fail natively
# An "assert absent" (assertThrows(NoSuchElementException…), invisibilityOfElementLocated, …) is
# never healed, in any mode.
# HEALER_ASSERTIONS=warn

# Optional: which browser the lifecycle launches. chrome (default) | firefox | edge.
# TAMASH_BROWSER=chrome

# Optional: reuse one WebDriver per test class (cookies/storage cleared between methods) instead
# of a fresh driver per test method. Faster; slightly less isolation. Defaults to per-method.
# TAMASH_REUSE_DRIVER=true

# Optional: bound (ms) the healer's own snapshot / JS / screenshot calls. Default 10000.
# The lifecycle sets Selenium's implicit wait to 0 so a broken findElement surfaces immediately.
# TAMASH_ACTION_TIMEOUT_MS=10000

# Optional: write a self-healing-aware HTML step report to this path after the test run.
# TAMASH_REPORT=target/tamash-report.html

# Optional: run the browser headed (visible) instead of headless. Defaults to headless.
# HEADLESS=false
